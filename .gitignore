# البيئة الافتراضية - لا تُرفع أبداً (ضخمة، وقابلة لإعادة الإنشاء عبر requirements.txt)
assd_env/

# بيئة معزولة لتحويل TFLite فقط (Python 3.11 + TensorFlow) - راجع export_tflite.py
tflite_env/

# ملف معايرة وهمي يُنشئه export_tflite.py تلقائياً عند الحاجة
calibration_image_sample_data_*.npy
calib_real_int8.npy

# مجموعة بيانات VOC2012 - عامة ومتاحة للتحميل مباشرة (~2GB)، ليست ملكاً للمشروع
# لتحميلها: راجع تعليمات train.py (--data-root) أو NEXT_STEPS.md
data/

# ملفات بايثون المُصرَّفة
__pycache__/
*.pyc

# ملفات نظام
.DS_Store

# حالة أدوات محلية (Claude Code) - ليست جزءاً من المشروع
.claude/

# نسخ checkpoints المرحلية (كل 10 حقب) - شبكة أمان محلية أثناء التدريب فقط،
# ليست ضرورية على GitHub؛ نحتفظ فقط بـ last.pth لكل مجلد checkpoints
checkpoints_v2/epoch_*.pth

# نسخة مرحلية للنقل عبر فلاشة USB إلى Jetson Nano - نسخة مطابقة لملفات
# موجودة أصلاً بجذر المشروع (exports/ + عدة سكربتات)، تكرارها بالمستودع
# يضاعف حجم الملفات الثنائية (~49MB) بلا أي فائدة حقيقية
jetson_deploy/
